{
  "name": "next-music",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "electron/dist/main.cjs",
  "author": "Allen Wang <wangzihao2010@outlook.com>",
  "description": "第三方网易云音乐客户端：纯客户端 Web SPA + Electron 桌面版",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "typecheck:electron": "tsc -p electron/tsconfig.json",
    "desktop:build:electron": "esbuild electron/src/main.ts electron/src/preload.ts --bundle --platform=node --format=cjs --target=node20 --outdir=electron/dist --out-extension:.js=.cjs --external:electron --external:@neteasecloudmusicapienhanced/api",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:build:mac": "node scripts/desktop-build.mjs --mac",
    "desktop:build:win": "node scripts/desktop-build.mjs --win",
    "desktop:build:linux": "node scripts/desktop-build.mjs --linux",
    "test:unit": "vitest run tests/unit",
    "test:components": "vitest run tests/components",
    "test": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "test:visual": "playwright test tests/visual",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "^4.41.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.1"
  }
}
